# ---------- run everything locally, no AWS needed ----------
KAVACH_MODE=local
KAVACH_TTS=auto            # auto = Windows speech if available, else silent mock; or: polly | sapi | mock
# KAVACH_BRAIN=mock

# ---------- real AWS ----------
# KAVACH_MODE=aws
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...            (or use an IAM role / aws configure)
# AWS_SECRET_ACCESS_KEY=...
# KAVACH_S3_BUCKET=my-kavach-bucket
# KAVACH_DDB_PREFIX=kavach
# KAVACH_BEDROCK_MODEL=anthropic.claude-opus-5   # Claude in Amazon Bedrock (Mantle) id
# KAVACH_BRAIN=bedrock                           # bedrock | converse (legacy ids like anthropic.claude-3-5-sonnet-20241022-v2:0) | mock
# KAVACH_BRAIN_EFFORT=high                       # low | medium | high
# KAVACH_POLLY_VOICE=Matthew
# KAVACH_POLLY_ENGINE=neural

# mix and match: e.g. Bedrock + Polly but local files
# KAVACH_MODE=local
# KAVACH_BRAIN=bedrock
# KAVACH_TTS=polly

# ---------- misc ----------
# KAVACH_PUBLIC_BASE_URL=http://localhost:8000   # used for /media links in local storage mode
# KAVACH_CORS_ORIGINS=*
# KAVACH_WORKERS=2
# KAVACH_VIDEO_WIDTH=1280
# KAVACH_VIDEO_HEIGHT=720
# KAVACH_FONT=C:\Windows\Fonts\segoepr.ttf
