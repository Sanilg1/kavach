# ---------- run everything locally, no AWS needed ----------
KAVACH_MODE=local
KAVACH_TTS=auto            # auto = Windows speech if available, else silent mock; or: polly | sapi | mock
# KAVACH_BRAIN=mock

# ---------- real AWS ----------
# KAVACH_MODE=aws
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...            (or use an IAM role / aws configure)
# AWS_SECRET_ACCESS_KEY=...
# KAVACH_S3_BUCKET=my-kavach-bucket
# KAVACH_DDB_PREFIX=kavach
# KAVACH_BRAIN=converse                          # converse (default, Bedrock Converse API) | bedrock (Anthropic Mantle client) | mock
# KAVACH_BEDROCK_REGION=us-west-2                # Bedrock region (quotas/model availability differ per region)
# KAVACH_BEDROCK_MODEL=us.anthropic.claude-opus-4-6-v1   # or us.anthropic.claude-sonnet-4-6 (faster/cheaper)
#                                                # Mantle client ids look like anthropic.claude-opus-5
# KAVACH_BRAIN_EFFORT=high                       # low | medium | high
# KAVACH_POLLY_VOICE=Matthew
# KAVACH_POLLY_ENGINE=neural

# mix and match: e.g. Bedrock + Polly but local files
# KAVACH_MODE=local
# KAVACH_BRAIN=bedrock
# KAVACH_TTS=polly

# ---------- stopgap brain while Bedrock is quota-limited ----------
# ANTHROPIC_API_KEY=sk-ant-...          # if set, the chain is Bedrock -> Anthropic API -> offline
# KAVACH_ANTHROPIC_MODEL=claude-opus-5

# ---------- quality / speed ----------
# KAVACH_BRAIN_VISION=1            # attach the PDF (topic map) and page images (plans) so the brain sees diagrams
# KAVACH_BRAIN_MAX_ATTACH_PAGES=4  # page images per teaching-plan call
# KAVACH_PLAN_CONCURRENCY=2        # topics planned in parallel while earlier ones render
# KAVACH_CAPTIONS=1                # burn synced captions (Polly speech marks) into the shorts

# ---------- misc ----------
# KAVACH_PUBLIC_BASE_URL=http://localhost:8000   # used for /media links in local storage mode
# KAVACH_CORS_ORIGINS=*
# KAVACH_WORKERS=2
# KAVACH_VIDEO_WIDTH=1280
# KAVACH_VIDEO_HEIGHT=720
# KAVACH_FONT=C:\Windows\Fonts\segoepr.ttf
